NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app_runtime:CHANGE_ME@localhost:5432/milktyway
DIRECT_URL=postgresql://app_migrator:CHANGE_ME@localhost:5432/milktyway
DB_POOL_MAX=5
CORS_ORIGINS=http://localhost:1800,http://localhost:5173
TRUST_PROXY_HOPS=0
# Generate independent random values of at least 32 characters. Never use these placeholders.
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
OTP_HMAC_SECRET=replace-with-a-different-random-secret
JWT_ISSUER=milktyway-api
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=604800
REMEMBER_SESSION_TTL_SECONDS=2592000
SESSION_IDLE_TTL_SECONDS=86400
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Development delivery writes OTPs to a local ignored mailbox; it is prohibited in production.
OTP_PROVIDER=development
OTP_MAILBOX_DIR=.data/otp
# For real delivery, select webhook and configure a trusted HTTPS SMS gateway.
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
